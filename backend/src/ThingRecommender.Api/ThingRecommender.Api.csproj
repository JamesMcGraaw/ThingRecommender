      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThingRecommender.Application\ThingRecommender.Application.csproj" />
    <ProjectReference Include="..\ThingRecommender.Infrastructure\ThingRecommender.Infrastructure.csproj" />
  </ItemGroup>

</Project>
